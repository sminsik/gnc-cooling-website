{
  "name": "gnc-cooling-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.11.2"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "check": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "build": "node scripts/build-ui.mjs && wrangler deploy --env='' --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "auth:check": "node scripts/check-staff-auth.mjs",
    "auth:initial-local": "node scripts/initial-admin-local.mjs",
    "setup:check": "node scripts/check-mvp-c.mjs",
    "dev:https": "node scripts/run-local-https.mjs",
    "scanner:local": "node dev/scanner/run.mjs",
    "test:scanner-local": "node tests/local-scanner.mjs",
    "ui:build": "node scripts/build-ui.mjs",
    "dev:design": "node scripts/dev-design.mjs",
    "check:local": "node scripts/check-local.mjs",
    "dev:local": "node scripts/start-local.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swiper": "^14.3.0"
  }
}

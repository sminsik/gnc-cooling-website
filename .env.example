# 인증 서비스 선정 후 로컬 .dev.vars 또는 운영 비밀 설정에 입력합니다.
# 빈 값에서는 직원 로그인이 닫힙니다. 실제 비밀값을 Git에 저장하지 마세요.
# 직원 인증용 HTTPS 주소. 현재 HTTP 공개 미리보기 주소와 구분합니다.
APP_ORIGIN=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 별도로 생성한 32자 이상의 무작위 비밀값
STAFF_AUTH_RATE_SECRET=

# 고객 접수는 회사 안내 승인·발송/검사 연결·운영 검수 전 활성화하지 않습니다.
# 연결 규격/잔여 조건: docs/inquiry-setup.md
CUSTOMER_ORIGIN=
INQUIRY_INTAKE_ENABLED=
# approved/version/text/retention/contact를 포함한 회사 승인 JSON. 임의 문구 사용 금지.
INQUIRY_POLICY=
INQUIRY_RATE_SECRET=
# 별도 무작위 32바이트 AES 키의 소문자 hex 64자 (발송 대기 링크 암호화)
INQUIRY_MAIL_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# INQUIRY_MAILER와 FILE_SCANNER는 환경변수가 아닌 신뢰하는 내부 서비스 binding입니다.
# INQUIRY_MAIL_STATUS도 선택 내부 서비스 binding입니다. 미연결 시 불명 결과의 재발송은 중지됩니다.
# 조회 계약: docs/mail-recovery.md

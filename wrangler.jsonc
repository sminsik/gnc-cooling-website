{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gnc-cooling-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "triggers": {"crons": ["* * * * *"]},
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gnc-cooling-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "gnc-cooling-local-files" }],
  "env": {
    "c-local": {
      "name": "gnc-cooling-c-local",
      "vars": {"STAFF_AUTH_MODE":"password", "APP_ORIGIN":"https://localhost:8788"},
      "d1_databases": [{"binding":"DB","database_name":"gnc-cooling-local","database_id":"00000000-0000-0000-0000-000000000001","migrations_dir":"migrations"}],
      "r2_buckets": [{"binding":"FILES","bucket_name":"gnc-cooling-local-files"}],
      "services": [{"binding":"FILE_SCANNER","service":"gnc-local-scanner"}]
    }
  }
}
